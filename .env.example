# Base URL of the OpenAI-compatible API, required: OPENAI_API_BASE_URL=http://192.168.1.102:1234/v1/ for LM Studio or Ollama
OPENAI_API_BASE_URL=https://api.openai.com/v1/
# The key, without the `Bearer ` prefix; left empty, no Authorization header is sent at all
OPENAI_API_KEY=
# Display names for the models, as id=alias pairs: OPENAI_MODEL_ALIASES=Qwen3.6-35b-a3b=Fast, gpt-5=Smart
OPENAI_MODEL_ALIASES=
# Model a first visit starts on, by identifier or by alias: OPENAI_MODEL_DEFAULT=Fast
OPENAI_MODEL_DEFAULT=
# Models to leave out of the menu, `*` allowed: OPENAI_MODEL_IGNORE=whisper-*, tts-*, dall-e-*, *embedding*
OPENAI_MODEL_IGNORE=
# Host port the interface is published on
PORT=1111
