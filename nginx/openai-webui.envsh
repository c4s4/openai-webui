#!/bin/sh
# Prepares the variables that openai-webui.conf.template needs.
#
# Sourced — not executed — by the NGinX entrypoint (hence the .envsh suffix and
# the 15- prefix, which puts it before 20-envsubst-on-templates.sh), so the
# exports below reach the envsubst pass that renders the template.

# A missing base URL would render as an empty proxy_pass and NGinX would refuse
# to start on a syntax error; say what is actually wrong instead.
if [ -z "${OPENAI_API_BASE_URL:-}" ]; then
    echo >&2 "$0: ERROR: OPENAI_API_BASE_URL is not set — see the .env file"
    exit 1
fi

# The trailing slash is what maps /api/… onto the base path of the API; adding
# it here spares the classic misconfiguration (/api/models proxied as-is).
case "$OPENAI_API_BASE_URL" in
    */) ;;
    *) OPENAI_API_BASE_URL="$OPENAI_API_BASE_URL/" ;;
esac
export OPENAI_API_BASE_URL

# An empty Authorization header is not sent at all, which is what a local
# backend without authentication expects.
if [ -n "${OPENAI_API_KEY:-}" ]; then
    export OPENAI_AUTHORIZATION="Bearer $OPENAI_API_KEY"
else
    export OPENAI_AUTHORIZATION=""
fi

# The aliases are rendered inside a single-quoted NGinX string, so a quote in
# there would close it early and leave a configuration NGinX rejects with a
# syntax error pointing at the template rather than at the variable.
case "${OPENAI_MODEL_ALIASES:-}" in
    *"'"*)
        echo >&2 "$0: ERROR: OPENAI_MODEL_ALIASES must not contain a quote — see the .env file"
        exit 1
        ;;
esac
export OPENAI_MODEL_ALIASES="${OPENAI_MODEL_ALIASES:-}"

# Form of the id=alias pairs, checked but not enforced: a mistyped alias is not
# worth refusing to serve the page, and the browser drops what it cannot read
# anyway. What it buys is a line in `docker compose logs` saying so, since the
# symptom — a model shown under its identifier — looks exactly like no alias at
# all. Whether the identifiers name models the backend actually offers cannot be
# told from here: the API may well not be up yet, and the page says it instead.
#
# Sourced, so the shell state belongs to the entrypoint: globbing is put back as
# it was, and the loop variables are dropped on the way out.
openai_saved_ifs="$IFS"
case "$-" in *f*) openai_saved_glob="off" ;; *) openai_saved_glob="on" ;; esac
set -f
IFS=,
openai_seen=""
for openai_pair in $OPENAI_MODEL_ALIASES; do
    # Trimmed on both edges only, as the page does — an inner space is part of
    # the name, and judging it here on other rules than there would mean warning
    # about something that works, or staying silent about something that does not.
    openai_id="$(printf %s "${openai_pair%%=*}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    openai_alias="$(printf %s "${openai_pair#*=}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"

    case "$openai_pair" in
        # A trailing or doubled comma: nothing said, nothing meant.
        *[![:space:]]*)
            case "$openai_pair" in
                *=*)
                    if [ -z "$openai_id" ] || [ -z "$openai_alias" ]; then
                        echo >&2 "$0: WARNING: OPENAI_MODEL_ALIASES: '$openai_pair' has an empty side — ignored"
                    else
                        case "$openai_seen" in
                            # The page keeps the last one; saying so beats letting
                            # one alias quietly win over another.
                            *"|$openai_id|"*)
                                echo >&2 "$0: WARNING: OPENAI_MODEL_ALIASES: '$openai_id' is aliased twice — the last one wins"
                                ;;
                            *)
                                openai_seen="$openai_seen|$openai_id|"
                                ;;
                        esac
                    fi
                    ;;
                *)
                    echo >&2 "$0: WARNING: OPENAI_MODEL_ALIASES: '$openai_pair' is not an id=alias pair — ignored"
                    ;;
            esac
            ;;
    esac
done
IFS="$openai_saved_ifs"
[ "$openai_saved_glob" = "on" ] && set +f
unset openai_saved_ifs openai_saved_glob openai_pair openai_id openai_alias openai_seen
